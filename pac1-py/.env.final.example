RUN_PROFILE=final
LLM_BACKEND=api
MODEL_ID=claude-sonnet-4-6
VERIFIER_MODEL=claude-haiku-4-5
VERIFIER_POLICY=adaptive
PARALLEL=4
BENCHMARK_HOST=https://api.bitgn.com
BENCHMARK_ID=bitgn/pac1-prod
# ANTHROPIC_API_KEY=sk-ant-...   # REQUIRED: copy to .env.final or export in shell
# BITGN_API_KEY=bgn-...           # REQUIRED for pac1-prod: https://bitgn.com/me/api-keys (set in .env or .env.final)

# Codex CLI profile (no Anthropic/Nebius/OpenRouter API key needed):
# make run-final-codex CODEX_MODEL=gpt-5.5
# CODEX_BIN=/path/to/newer/codex   # optional; Makefile auto-prefers VS Code extension Codex CLI
# LLM_BACKEND=codex_cli
# MODEL_ID=gpt-5.5
# VERIFIER_BACKEND=codex_cli
# VERIFIER_MODEL=gpt-5.5
